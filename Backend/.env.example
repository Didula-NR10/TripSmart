# ─────────────────────────────────────────────────────────────────────────────
# Trip Smart backend — copy this file to `.env` and fill in the values below.
# The tables (districts, weather_observations, forecast_runs) are created
# AUTOMATICALLY in Supabase the first time the server starts. You never run
# SQL by hand.
# ─────────────────────────────────────────────────────────────────────────────

PROJECT_NAME="Trip Smart"
ENVIRONMENT=development

# ─── REQUIRED: the database connection ───────────────────────────────────────
# Where to find it in Supabase:
#   1. Open your project at https://supabase.com/dashboard
#   2. Click the "Connect" button at the top of the page
#   3. Under "Connection String", pick the **Session pooler** tab
#      (use Session pooler, NOT "Direct connection" — direct is IPv6-only
#       and usually fails on home networks)
#   4. Copy the URI. It looks like:
#      postgresql://postgres.abcdefghij:[YOUR-PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:5432/postgres
#   5. Replace [YOUR-PASSWORD] with your database password
#      (the one you chose when creating the project; reset it under
#       Project Settings → Database if you forgot it)
# NOTE: special characters in the password must be percent-encoded in a URL.
# Your password contains "@", which is written as "%40" below.
# Session pooler URL (IPv4-compatible — works on any network). The old direct
# host (db.fhetsbuzzrzceuscycmf.supabase.co) is IPv6-only and fails when the
# network has no IPv6.
SUPABASE_DB_URL=postgresql://postgres.your-project-ref:your-url-encoded-password@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres

# ─── OPTIONAL: Supabase API credentials (not used yet) ───────────────────────
# Only needed later for Supabase Auth / storage features, NOT for forecasting.
# Found under: Project Settings → API
#   SUPABASE_URL  = the "Project URL"          (https://<your-ref>.supabase.co)
#   SUPABASE_KEY  = the "anon / public" API key (a long JWT starting with eyJ...)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_KEY=your-anon-public-api-key

# ─── Security ────────────────────────────────────────────────────────────────
# Any long random string; used to sign this API's own JWTs.
# Generate one with:  python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=

# Comma-separated list of frontend origins allowed to call this API.
# The frontend runs on localhost (Expo dev server) while the backend is on
# Hugging Face Spaces — allow every common localhost port so a port change
# never breaks the app. (In development the CORS regex also accepts any
# localhost port automatically.)
ALLOWED_ORIGINS=http://localhost:8081,http://localhost:19006,http://localhost:3000,http://localhost:5173,http://127.0.0.1:8081,http://127.0.0.1:19006,http://127.0.0.1:3000,http://127.0.0.1:5173

# ─── Forecast behaviour ──────────────────────────────────────────────────────
# Reuse a completed model run for this many minutes before re-running the GRU.
FORECAST_CACHE_MINUTES=60

# ─── Email: sends the signup / password-reset OTP codes ──────────────────────
# Sent over HTTPS via SendGrid, NOT raw SMTP — Render's free tier blocks
# outbound SMTP ports (25/465/587) as of September 2025, so a Gmail
# app-password setup silently fails there no matter how correct it is.
#   1. Sign up free at https://signup.sendgrid.com/ (100 emails/day free)
#   2. Settings -> Sender Authentication -> Single Sender Verification ->
#      verify the address you want emails to come FROM (e.g. your Gmail).
#      You only need to verify the sender, not a whole domain.
#   3. Settings -> API Keys -> Create API Key (Full Access, or at minimum
#      "Mail Send" permission) -> copy it (shown only once).
#   4. SENDGRID_API_KEY = that key
#      SMTP_FROM_EMAIL  = the exact address you verified in step 2
# If these stay empty in development, OTP codes are not emailed — they appear
# in the server log AND in the API response (dev_otp) so you can still test.
SENDGRID_API_KEY=
SMTP_FROM_EMAIL=your-verified-sender@example.com

# ─── OPTIONAL legacy fallback: raw SMTP (works locally / on a paid Render
# tier; blocked on Render's free tier — leave SENDGRID_API_KEY set above and
# ignore this unless you have a specific reason to use SMTP instead) ─────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-gmail-address@gmail.com
SMTP_APP_PASSWORD=your-gmail-app-password

WEATHERAPI_KEY=your-weatherapi-com-key

# ─── Destination search on the map picker (Google Geocoding) ─────────────────
# Demo key — swap for a production key with billing enabled before shipping.
GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# ─── Google Sign-In (native Android) ─────────────────────────────────────────
# The WEB-application-type OAuth client ID — NOT the Android one. This is the
# audience Google puts on ID tokens from the native Android sign-in flow, so
# it's what the backend verifies tokens against. The client secret is never
# used (no server-side code exchange happens) and must not be stored here.
GOOGLE_OAUTH_WEB_CLIENT_ID=29878567929-e318u98a03dpn9h08jcvo4bebfgt9aqr.apps.googleusercontent.com